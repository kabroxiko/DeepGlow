{
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[\\w-]+?)\\s+depName=(?<depName>[^\\s]+?)(?:\\s+versioning=(?<versioning>[^\\s]+?))?\\s+\\w+\\s*=\\s*[^@]+@(?<currentValue>.+)"
      ]
    }
  ]
}
