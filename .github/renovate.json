{
  "$schema": "https://renovatebot.com",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["^platformio\\.ini$"],
      "matchStrings": [
        "(?m)^platform\\s*=\\s*(?<depName>[^@\\n]+)(?:@(?<currentValue>[^\\n]+))?"
      ],
      "datasourceTemplate": "custom.pio-platform",
      "depTypeTemplate": "platform"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["^platformio\\.ini$"],
      "matchStrings": [
        "(?m)^\\s*(?<depName>[^@\\n\\s]+)@(?<currentValue>[^\\n\\s]+)"
      ],
      "datasourceTemplate": "custom.pio-library",
      "depTypeTemplate": "library"
    }
  ],
  "customDatasources": {
    "pio-platform": {
      "defaultRegistryUrlTemplate": "https://platformio.org{{depName}}",
      "transformTemplates": [
        "{\"releases\": [{\"version\": version, \"releaseTimestamp\": date_published}]}"
      ]
    },
    "pio-library": {
      "defaultRegistryUrlTemplate": "https://platformio.org{{depName}}/core",
      "transformTemplates": [
        "{\"releases\": [{\"version\": version, \"releaseTimestamp\": date_published}]}"
      ]
    }
  }
}
