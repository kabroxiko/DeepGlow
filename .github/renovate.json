{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^platformio\\.ini$"],
      "matchStrings": [
        "platform = (?<depName>espressif32)@(?<currentValue>[0-9.]+)"
      ],
      "packageNameTemplate": "platformio/platform-espressif32",
      "datasourceTemplate": "github-releases"
    }
  ]
}
