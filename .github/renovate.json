{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "recreateWhen": "always",
  "vulnerabilityAlerts": {"enabled": false},
  "commitMessagePrefix": "🤖",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "commitMessageSuffix": "",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    // {
    //   "customType": "regex",
    //   "managerFilePatterns": ["/^platformio\\.ini$/"],
    //   "matchStrings": [
    //     "platform\\s*=\\s*(?<depName>[^@\\s\\n]+)@(?<currentValue>[0-9.]+)"
    //   ],
    //   "matchStringsStrategy": "any",
    //   "datasourceTemplate": "custom.ds-pio-platform",
    //   "depNameTemplate": "{{depName}}",
    //   "versioningTemplate": "loose",
    //   "depTypeTemplate": "dep-pio-platform"
    // },
    // {
    //   "customType": "regex",
    //   "managerFilePatterns": ["/^platformio\\.ini$/"],
    //   "matchStringsStrategy": "recursive",
    //   "matchStrings": [
    //     "lib_deps\\s*=\\s*(?<dependencies>(?:[^\\n]+|\\n\\t+)+)",
    //     "(?<depName>[a-zA-Z0-9_-]+)@(?<currentValue>[0-9.]+)"
    //   ],
    //   "datasourceTemplate": "custom.ds-pio-library",
    //   "depNameTemplate": "{{depName}}",
    //   "versioningTemplate": "loose",
    //   "depTypeTemplate": "dep-pio-library"
    // },
    {
      "customType": "regex",
      "description": "Extractor aislado y exclusivo para la plataforma IDF",
      "managerFilePatterns": ["/^src/idf_component\\.yml$/"],
      "matchStrings": [
        "(?:^|\\n)[ \\t]+(?<depName>idf):\\s+version:\\s+[\"']?(?<replaceString>(?:[~^]|>=|<=|>|<)?(?<currentValue>v?[0-9.]+))[\"']?"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "espressif/esp-idf",
      "versioningTemplate": "semver",
      "depTypeTemplate": "dep-idf-engine"
    },
    {
      "customType": "regex",
      "description": "Extractor recursivo exclusivo para componentes (ignora idf de forma estructural)",
      "managerFilePatterns": ["/^src/idf_component\\.yml$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "^dependencies:\\s*(?<dependencies>(?:[^\\n]+|\\n[ \\t]+)+)",
        "(?:^|\\n)[ \\t]+(?<depName>[a-zA-Z0-9_\\-]+\\/[a-zA-Z0-9_\\-]+):\\s*(?:version:\\s*)?[\"']?(?:[~^]|>=|<=|>|<)?(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "custom.ds-espressif-component",
      "depNameTemplate": "{{{depName}}}",
      "versioningTemplate": "semver",
      "depTypeTemplate": "dep-idf-component"
    }
  ],
  "customDatasources": {
    "ds-pio-platform": {
      "description": "PlatformIO Platform Registry",
      "defaultRegistryUrlTemplate": "https://api.registry.platformio.org/v3/packages/{{#if (containsString packageName '/')}}{{{replace '/.*' '' packageName}}}{{else}}platformio{{/if}}/platform/{{{replace '.*/' '' packageName}}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$map($.versions, function($v) { { \"version\": $v.name, \"releaseTimestamp\": $v.released_at } })], \"homepage\": $encodeUrl($join([\"https://registry.platformio.org/\",$.type,\"/\",$.owner.username,\"/\",$.name])) }"
      ]
    },
    "ds-pio-library": {
      "description": "PlatformIO Library Registry",
      "defaultRegistryUrlTemplate": "https://api.registry.platformio.org/v3/packages?query={{{packageName}}}&page=1&limit=1",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$map($.items[0].version, function($v) { { \"version\": $v.name, \"releaseTimestamp\": $v.released_at } })], \"homepage\": $encodeUrl($join([\"https://registry.platformio.org/\",$.items[0].type,\"/\",$.items[0].owner.username,\"/\",$.items[0].name])) }"
      ]
    },
    "ds-espressif-component": {
      "description": "Espressif Component Registry Static JSON Endpoint",
      "defaultRegistryUrlTemplate": "https://components-file.espressif.com/components/{{{packageName}}}.json",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [$map($.versions[0], function($v) { { \"version\": $v.version, \"releaseTimestamp\": $v.created_at } })], \"homepage\": \"https://components.espressif.com/components/{{{packageName}}}\" }"
      ]
    }
  },
  "packageRules": [
    {
      "groupName": "PlatformIO Platform",
      "matchDepTypes": ["dep-pio-platform"],
      "addLabels": ["dependencies", "pio:platform"]
    },
    {
      "groupName": "PlatformIO Libraries",
      "matchDepTypes": ["dep-pio-library"],
      "addLabels": ["dependencies", "pio:library"]
    },
    {
      "groupName": "ESP-IDF Components",
      "matchDepTypes": ["dep-idf-component"],
      "addLabels": ["dependencies", "esp-idf:component"]
    },
    {
      "matchManagers": ["regex"],
      "matchDepTypes": ["dep-idf-component"],
      "rangeStrategy": "update-lockfile",
      "matchPackageNames": ["espressif/esp-idf"],
      "enabled": false
    }
  ]
}
