{
  "$schema": "https://renovatebot.com",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["^platformio\\.ini$"],
      "matchStrings": [
        "platform\\s*=\\s*(?<depName>espressif32)@(?<currentValue>[0-9.]+)"
      ],
      "packageNameTemplate": "platformio/platform-espressif32",
      "datasourceTemplate": "github-releases",
      "depTypeTemplate": "platform"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["^platformio\\.ini$"],
      "matchStrings": [
        "^\\s*(?<depName>[^@\\n\\s;]+)@(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "custom.pio-library",
      "depTypeTemplate": "library"
    }
  ],
  "customDatasources": {
    "pio-library": {
      "defaultRegistryUrlTemplate": "https://platformio.org{{{packageName}}}",
      "format": "json"
    }
  }
}
