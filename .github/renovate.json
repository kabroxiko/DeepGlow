{
  "$schema": "https://renovatebot.com",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "(?m)^platform\\s*=\\s*(?<depName>[^@\\n]+)(?:@(?<currentValue>[^\\n]+))?"
      ],
      "datasourceTemplate": "custom.pio-platform"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "(?m)^\\s*(?<depName>[^@\\n\\s]+)@(?<currentValue>[^\\n\\s]+)"
      ],
      "datasourceTemplate": "custom.pio-library"
    }
  ],
  "customDatasources": {
    "pio-platform": {
      "defaultRegistryUrlTemplate": "https://platformio.org{{{replace '.*/' '' packageName}}}",
      "format": "json"
    },
    "pio-library": {
      "defaultRegistryUrlTemplate": "https://platformio.org{{{replace '.*/' '' packageName}}}",
      "format": "json"
    }
  }
}
