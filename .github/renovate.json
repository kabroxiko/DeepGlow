{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "(?m)^platform\\s*=\\s*(?<depName>[^@\\n]+)(?:@(?<currentValue>[^\\n]+))?"
      ],
      "datasourceTemplate": "github-tags",
      "depTypeTemplate": "platform"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "(?m)^\\s*(?<depName>[^@\\n\\s]+)@(?<currentValue>[^\\n\\s]+)"
      ],
      "datasourceTemplate": "github-tags",
      "depTypeTemplate": "library"
    }
  ]
}
