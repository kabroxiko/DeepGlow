{
  "$schema": "https://renovatebot.com",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "(?m)^platform\\s*=\\s*(?<depName>[^@\\n]+)(?:@(?<currentValue>[^\\n]+))?"
      ],
      "datasourceTemplate": "github-tags",
      "depTypeTemplate": "platform"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/)platformio\\.ini$"],
      "matchStrings": [
        "(?m)^lib_deps\\s*=\\s*(?:[^\\n]*\\n(?:\\s+[^\\n]*\\n)*)"
      ],
      "matchStringsStrategy": "recursive",
      "customManagers": [
        {
          "customType": "regex",
          "matchStrings": [
            "(?m)^\\s*(?<depName>[^@\\n]+)@(?<currentValue>[^\\n]+)"
          ],
          "datasourceTemplate": "github-tags",
          "depTypeTemplate": "library"
        }
      ]
    }
  ]
}
